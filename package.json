{
  "name": "imovies-app",
  "version": "1.0.0",
  "description": "IMovies - Movie ticket booking made simple (MERN Full Stack)",
  "type": "module",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
